<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="8dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Wexcom"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btn_new_tx"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="#2A2F3A"
            android:gravity="center"
            android:padding="8dp"
            android:text="+ Tx"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/btn_debt"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="#3A2A2A"
            android:gravity="center"
            android:padding="8dp"
            android:text="Debt"
            android:textColor="#FF8A80"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/btn_payment"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="#2A3A2F"
            android:gravity="center"
            android:padding="8dp"
            android:text="Pay"
            android:textColor="#A5D6A7"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/btn_roulette"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="#3A2F4A"
        android:gravity="center"
        android:padding="8dp"
        android:text="Debt roulette"
        android:textColor="#CE93D8"
        android:textSize="12sp" />
</LinearLayout>
